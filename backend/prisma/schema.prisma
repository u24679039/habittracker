// HabitTracker database schema (Prisma)
// Owned tables for this workstream are the ones the Dashboard/Analytics 
// classes read from; User/Habit/Group tables are modelled here too 
// (marked below) so this slice has a real schema to migrate and query 
// against ahead of Sprint 3 integration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Frequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum HabitStatus {
  ACTIVE
  ARCHIVED
}

enum LogStatus {
  COMPLETED
  REST_DAY
  SNOOZED
  MISSED
}

enum GroupRole {
  OWNER
  MEMBER
}

enum ActivityType {
  HABIT_COMPLETED
  STREAK_MILESTONE
  MEMBER_JOINED
  MEMBER_LEFT
  GROUP_ANNOUNCEMENT
}

// [owned elsewhere - Yingisani's Auth workstream] 
model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")

  habits          Habit[]
  memberships     GroupMembership[]
  createdGroups   AccountabilityGroup[] @relation("GroupCreator")
  activities      Activity[]

  @@map("users")
}

// [owned elsewhere - David's Habit Management workstream]
model Habit {
  habitId     Int         @id @default(autoincrement()) @map("habit_id")
  userId      Int         @map("user_id")
  name        String
  description String?
  targetValue Decimal     @map("target_value")
  targetUnit  String      @map("target_unit")
  frequency   Frequency
  status      HabitStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  archivedAt  DateTime?   @map("archived_at")

  user       User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  logs       HabitLog[]
  activities Activity[]

  @@map("habits")
}

// [owned elsewhere - David's Habit Management workstream]
model HabitLog {
  logId     Int       @id @default(autoincrement()) @map("log_id")
  habitId   Int       @map("habit_id")
  logDate   DateTime  @map("log_date") @db.Date
  value     Decimal   @default(0)
  status    LogStatus
  note      String?   @default("")
  createdAt DateTime  @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [habitId], onDelete: Cascade)

  @@unique([habitId, logDate])
  @@index([habitId, logDate])
  @@map("habit_logs")
}

// [owned elsewhere - Shahd's Micro-Group workstream]
model AccountabilityGroup {
  groupId     Int      @id @default(autoincrement()) @map("group_id")
  name        String
  description String?
  inviteCode  String   @unique @map("invite_code")
  maxMembers  Int      @default(5) @map("max_members")
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  isPublic    Boolean  @default(false) @map("is_public")
  isActive    Boolean  @default(true) @map("is_active")

  creator     User              @relation("GroupCreator", fields: [createdBy], references: [userId])
  memberships GroupMembership[]
  activities  Activity[]

  @@map("accountability_groups")
}

// [owned elsewhere - Shahd's Micro-Group workstream]
model GroupMembership {
  membershipId Int       @id @default(autoincrement()) @map("membership_id")
  userId       Int       @map("user_id")
  groupId      Int       @map("group_id")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  role         GroupRole @default(MEMBER)

  user  User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  group AccountabilityGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_memberships")
}

// [ANALYTICS] read by Dashboard.getGroupActivity()
// write side (Activity.create()) belongs to Monal's Social Feed workstream.
model Activity {
  activityId   Int          @id @default(autoincrement()) @map("activity_id")
  groupId      Int          @map("group_id")
  userId       Int          @map("user_id")
  habitId      Int?         @map("habit_id")
  activityType ActivityType @map("activity_type")
  message      String
  timestamp    DateTime     @default(now())

  group AccountabilityGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [userId])
  habit Habit?              @relation(fields: [habitId], references: [habitId])

  @@index([groupId, timestamp])
  @@map("activities")
}
