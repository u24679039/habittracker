// Prisma Client configuration
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL database configuration
datasource db {
  provider = "postgresql"
}

// Stores the details and settings of each accountability group
model AccountabilityGroup {
  groupId        Int      @id @default(autoincrement())
  name           String
  description    String?
  invitationCode String   @unique
  maxMembers     Int
  creatorId      Int
  creationDate   DateTime @default(now())
  isPublic       Boolean
  isActive       Boolean

  memberships    GroupMembership[]
}

// Defines the roles that a user can have within a group
enum GroupRole {
  OWNER
  MEMBER
}

// Represents a user's membership and role within an accountability group
model GroupMembership {
  membershipId Int       @id @default(autoincrement())
  userId       Int
  groupId      Int
  joinedAt     DateTime  @default(now())
  role         GroupRole

  // Relate each membership to its accountability group
  group        AccountabilityGroup @relation(fields: [groupId], references: [groupId])

  // Prevent the same user from joining the same group more than once
  @@unique([userId, groupId])
}