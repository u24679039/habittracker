// schema.prisma
// My part: Social Activity Feed & Notifications (EH-61)
//
// These model definitions are NOT connected to a real running database
// yet - Prisma isn't even installed. This is the schema DESIGN, written
// in Prisma's own syntax, showing exactly what the real tables will look
// like once this gets wired into the team's actual database.
//
// The Activity model and its enum values match what was already agreed
// on in our group design document's class diagram, so this isn't a new
// invention - it's that same design, now written in the format Prisma
// actually expects.

model Activity {
  id           Int          @id @default(autoincrement())
  groupId      Int
  userId       Int
  habitId      Int? // optional - milestones aren't tied to one specific habit
  activityType ActivityType
  message      String
  timestamp    DateTime     @default(now())
}

enum ActivityType {
  HABIT_COMPLETED
  STREAK_MILESTONE
  MEMBER_JOINED
  MEMBER_LEFT
  GROUP_ANNOUNCEMENT
}

// This is new for EH-61 specifically - representing pending/sent
// notifications, separate from the Activity feed itself. An Activity
// is "something that happened"; a NotificationQueue entry is "something
// that still needs to be emailed/sent to someone."
model NotificationQueue {
  id        Int                @id @default(autoincrement())
  userId    Int
  message   String
  status    NotificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  sentAt    DateTime? // filled in once it's actually been sent
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
