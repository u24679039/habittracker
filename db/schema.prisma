// Notification queue & activity feed DB schema (EH-61)
//
// These model definitions are NOT connected to a real running database
// yet. This is the schema design, written
// in Prisma's own syntax, showing what the real tables will look
// like once this gets wired into the team's actual database.
//
// The Activity model and its enum values match what was already agreed
// on in the group design document's class diagram. Therefore, it is the same
// design, written in the format Prisma expects

// Activity mirrors an event happening in a group (a habit log, a milestone, someone
// joining) and NotificationQueue mirrors "something waiting to be sent". Two enums (
//  ActvityType, NotificationStatus) restrict those fields to a fixed set of valid values

model Activity {
  id           Int          @id @default(autoincrement())
  groupId      Int
  userId       Int
  habitId      Int? // optional - milestones aren't tied to one specific habit
  activityType ActivityType
  message      String
  timestamp    DateTime     @default(now())
}

enum ActivityType {
  HABIT_COMPLETED
  STREAK_MILESTONE
  MEMBER_JOINED
  MEMBER_LEFT
  GROUP_ANNOUNCEMENT
}

// This represents pending/sent notifications which is separate from the Activity feed
// An Activity = something that happened
// A NotificationQueue entry = something that still needs to be emailed/sent to someone

model NotificationQueue {
  id        Int                @id @default(autoincrement())
  userId    Int
  message   String
  status    NotificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  sentAt    DateTime? // filled in once it's actually been sent
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
