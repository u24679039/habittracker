generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  USER
  ADMIN
}

enum Frequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum HabitStatus {
  ACTIVE
  ARCHIVED
}

enum LogStatus {
  COMPLETED
  REST_DAY
  SNOOZED
  MISSED
}

enum GroupRole {
  OWNER
  MEMBER
}

enum ActivityType {
  HABIT_COMPLETED
  STREAK_MILESTONE
  MEMBER_JOINED
  MEMBER_LEFT
  GROUP_ANNOUNCEMENT
}


// [owned elsewhere - Yingisani's Auth workstream] 
model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")

  habits          Habit[]
  memberships     GroupMembership[]
  createdGroups   AccountabilityGroup[] @relation("GroupCreator")
  activities      Activity[]
  habitLogs HabitLog[]
  @@map("users")
}


// habits
model Habit {
  habitId Int    @id @default(autoincrement())
  userId  Int
  title   String
  description String?

  // Keeping this as an Int on purpose - the app code (Habit.js) uses
  // parseInt() when it saves or updates this value, to match. If
  // fractional targets ever become something you actually need (5.5 km,
  // say), this needs to become a Float first, and the app code would need
  // to switch back to parseFloat().
  targetValue Int
  targetUnit  String
  frequency   String @default("daily")

  // Added a default here so a habit can never quietly end up with an
  // empty status string sitting in the database - a couple of spots in
  // the app used to let that happen before this got a default on the code
  // side too.
  StatusOfHabit String @default("ACTIVE")

  Activated  Boolean   @default(true)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  // Added a default of 0 - the app always supplies a value today, but this
  // is a bit of a safety net in case something else ever inserts a habit
  // directly (a seed script, a manual fix, whatever) and forgets to.
  currValue Int @default(0)

  // Controls which groups receive activity for this habit.
  sharingMode String @default("PRIVATE")
  sharedGroupIds Int[] @default([])

  logs HabitLog[]
  activities Activity[]
  // GET /api/users/:userId/habits filters on userId on basically every
  // request, so it's worth having an index here rather than making
  // Postgres scan the whole table once it has real data in it.
  @@index([userId])
  @@map("habits")
}

// analytics and logs
model HabitLog {
  logId Int @id @default(autoincrement())

  habitId Int
  habit   Habit @relation(fields: [habitId], references: [habitId], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  value       Float?
  status      String

  // Same idea as StatusOfHabit above - the app always defaults note to ""
  // itself, but giving it a default here too means that guarantee holds
  // even for rows that don't come through the app layer.
  note String @default("")

  // habitId gets queried constantly - streaks, history, completion rate,
  // "did we already log this today" - and userId shows up a fair bit too.
  // These indexes are what keep those lookups fast once there's a real
  // amount of data in here.
  @@index([habitId])
  @@index([userId])
  @@map("habit_logs")
}

// One thing worth flagging: the defaults and indexes added above are
// additive and shouldn't break any existing data, but editing this file
// alone doesn't change anything in the actual database - you'll still
// need to run something like `prisma migrate dev` to apply them.
// [owned elsewhere - Shahd's Micro-Group workstream]
model AccountabilityGroup {
  groupId     Int      @id @default(autoincrement()) @map("group_id")
  name        String
  description String?
  inviteCode  String   @unique @map("invite_code")
  maxMembers  Int      @default(5) @map("max_members")
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  isPublic    Boolean  @default(false) @map("is_public")
  isActive    Boolean  @default(true) @map("is_active")
  creator     User              @relation("GroupCreator", fields: [createdBy], references: [userId])
  memberships GroupMembership[]
  activities  Activity[]
  flagReason String
  reveiwed Boolean @default(false)
  @@map("accountability_groups")
}

// [owned elsewhere - Shahd's Micro-Group workstream]
model GroupMembership {
  membershipId Int       @id @default(autoincrement()) @map("membership_id")
  userId       Int       @map("user_id")
  groupId      Int       @map("group_id")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  role         GroupRole @default(MEMBER)

  user  User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  group AccountabilityGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_memberships")
}

// [ANALYTICS] read by Dashboard.getGroupActivity() - the write
// side (Activity.create()) belongs to Monal's Social Feed workstream.
model Activity {
  activityId   Int          @id @default(autoincrement()) @map("activity_id")
  groupId      Int          @map("group_id")
  userId       Int          @map("user_id")
  habitId      Int?         @map("habit_id")
  activityType ActivityType @map("activity_type")
  message      String
  timestamp    DateTime     @default(now())

  group AccountabilityGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [userId])
  habit Habit?              @relation(fields: [habitId], references: [habitId])

  @@index([groupId, timestamp])
  @@map("activities")
}
